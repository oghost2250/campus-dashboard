# npm >= 11.19 blocks lifecycle scripts unless allowlisted.
# Only these packages are permitted to run postinstall/build scripts.
allow-scripts[]=prisma
allow-scripts[]=@prisma/client
allow-scripts[]=@prisma/engines
allow-scripts[]=sharp
allow-scripts[]=@tailwindcss/oxide
allow-scripts[]=esbuild
allow-scripts[]=unrs-resolver
allow-scripts[]=@parcel/watcher

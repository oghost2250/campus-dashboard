# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_dashboard?schema=public"
# Direct (unpooled) connection for migrations. On Neon, use the non-pooler URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/student_dashboard?schema=public"

# Serverless only: per-instance Prisma pool size when DATABASE_URL points at a
# Neon/PgBouncer "-pooler" host. Keep it small (3-5) on Vercel.
# PRISMA_CONNECTION_LIMIT="5"

# Auth.js v5. Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional Google OAuth — leave blank to hide the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: restrict registration to one university domain.
# Leave blank to accept any address. Example: "zewailcity.edu.eg"
ALLOWED_EMAIL_DOMAIN=""

# Public base URL, used in metadata / emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Web Push (VAPID) ------------------------------------------------------
# Generate a fresh pair with: npx web-push generate-vapid-keys --json
# Both keys are required for "Enable class alarms"; keep the private key secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.com"

# --- Lecture alarm cron ----------------------------------------------------
# Vercel Cron calls GET /api/cron/lecture-alarms with
# "Authorization: Bearer $CRON_SECRET" when this variable is set.
CRON_SECRET=""
# IANA time zone used to read schedule days/times (stored as local wall time).
APP_TIME_ZONE="Africa/Cairo"
